<ui:DialogWindow x:Class="OAIRouter.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OAIRouter.Ui"
        Title="导入配置"
        Height="220" MinHeight="180">
    <!-- 表单类对话框：宽高都按内容拟合（ImportWindow.MeasureContent 量勾选项与说明里最长的一行），
         内容短就窄、数量变多就宽 —— 这里不写死宽度，也不拿 MinWidth 兜底。 -->
    <ui:DialogShell x:Name="Shell" Style="{StaticResource DialogShell}"
                    Kind="Question" Headline="选择要导入的内容" PrimaryText="导入" SecondaryText="取消">
        <StackPanel>
            <TextBlock x:Name="Hint" Text="未勾选的部分保持不变。上游密钥仅原 Windows 用户可解密；跨账户或电脑导入后需重新配置。"
                       Style="{StaticResource Hint}" Margin="0,0,0,12" TextWrapping="Wrap" />

            <!-- 括号里的数量由 Tag 提供，文案本身不落到 C# -->
            <CheckBox x:Name="ChkRoutes" Margin="0,0,0,10" IsChecked="True">
                <TextBlock><Run Text="路由规则（" /><Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=CheckBox}, Mode=OneWay}" /><Run Text=" 条）" /></TextBlock>
            </CheckBox>
            <CheckBox x:Name="ChkMaps" Margin="0,0,0,10" IsChecked="True">
                <TextBlock><Run Text="模型映射（" /><Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=CheckBox}, Mode=OneWay}" /><Run Text=" 条）" /></TextBlock>
            </CheckBox>
            <CheckBox x:Name="ChkPricing" Margin="0,0,0,10" IsChecked="True">
                <TextBlock><Run Text="价格表（" /><Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=CheckBox}, Mode=OneWay}" /><Run Text=" 条）" /></TextBlock>
            </CheckBox>
            <CheckBox x:Name="ChkModels" Margin="0,0,0,10" IsChecked="True">
                <TextBlock><Run Text="模型库（" /><Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=CheckBox}, Mode=OneWay}" /><Run Text=" 个）" /></TextBlock>
            </CheckBox>
            <CheckBox x:Name="ChkSettings" Content="程序设置（端口、token 上下限、日志上限）" IsChecked="False" />
        </StackPanel>
    </ui:DialogShell>
</ui:DialogWindow>
