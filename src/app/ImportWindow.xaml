<Window x:Class="OAIRouter.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入配置"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F2F6FB" FontFamily="Microsoft YaHei UI">
    <Border Style="{StaticResource Card}" Margin="14" Padding="16,14">
        <StackPanel>
            <TextBlock Text="选择要导入的内容" Style="{StaticResource H1}" />
            <TextBlock Text="未勾选的部分保持当前配置不变。导入会覆盖同名内容。"
                       Style="{StaticResource Hint}" Margin="0,6,0,12" TextWrapping="Wrap" />

            <CheckBox x:Name="ChkRoutes" Content="路由规则" Margin="0,0,0,10" IsChecked="True" />
            <CheckBox x:Name="ChkMaps" Content="模型映射" Margin="0,0,0,10" IsChecked="True" />
            <CheckBox x:Name="ChkPricing" Content="价格表" Margin="0,0,0,10" IsChecked="True" />
            <CheckBox x:Name="ChkModels" Content="模型库" Margin="0,0,0,10" IsChecked="True" />
            <CheckBox x:Name="ChkSettings" Content="程序设置（端口、token 上下限、日志上限）" IsChecked="False" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="84" Click="OnCancel" />
                <Button Content="导入" Style="{StaticResource PrimaryButton}" Width="96" Margin="8,0,0,0"
                        Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
