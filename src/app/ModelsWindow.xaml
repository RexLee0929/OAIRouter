<Window x:Class="OAIRouter.ModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型库"
        Width="520" Height="580" MinWidth="420" MinHeight="420"
        Background="#F2F6FB" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="NewBox" Style="{StaticResource Input}" Width="300"
                             ToolTip="输入模型名后回车或点添加" KeyDown="OnNewKeyDown" />
                    <Button Content="添加" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="8,0,0,0"
                            Click="OnAdd" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="SortBtn" Content="名称 ↑" Style="{StaticResource GhostButton}" Padding="10,4"
                            Click="OnSort" />
                    <Button Content="从用量导入" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" Click="OnImportUsage" />
                    <Button Content="恢复默认" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" Click="OnRestoreDefault" />
                    <TextBlock Text="这里维护的模型会出现在价格表和映射表的下拉里" Style="{StaticResource Hint}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,12,0,0">
            <ListBox x:Name="ModelList" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource LogItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding}" Style="{StaticResource CellText}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource RowDelete}" Click="OnRemove"
                                    Tag="{Binding}" ToolTip="从模型库移除" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Width="96"
                    HorizontalAlignment="Right" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
