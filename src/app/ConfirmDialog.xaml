<Window x:Class="OAIRouter.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F2F6FB" FontFamily="Microsoft YaHei UI">
    <Border Style="{StaticResource Card}" Margin="14" Padding="16,14">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Sub}" TextWrapping="Wrap"
                       Margin="0,10,0,0" LineHeight="19" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="84" Click="OnCancel" />
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}"
                        Width="96" Margin="8,0,0,0" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
