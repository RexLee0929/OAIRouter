<ui:DialogWindow x:Class="OAIRouter.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OAIRouter.Ui"
        xmlns:local="clr-namespace:OAIRouter"
        Height="300" MinHeight="240">
    <!-- 三段式（规范 §八，与 txtFormat 同构）：内容框 / 联系条 / 按钮栏。
         尺寸：宽由 AboutDialog.MeasureContent 按 ABOUT.md 里最宽的一行算出来，高由
         OnFitPass 按富文本真实内容高度校正 —— 这里不写宽度，改文案不用改数字。
         （不能用 SizeToContent：WPF 对 RichTextBox 量高偏小，会把后两段挤出窗口。）
         标题栏是原生的 —— 对话框必须是主窗口长出来的一层，不许自绘假标题栏。 -->
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1) 内容框：只读 RichTextBox，正文可选中可复制 -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,20,14,26" Margin="0,0,0,10">
            <RichTextBox x:Name="Doc" IsReadOnly="True" IsDocumentEnabled="False"
                         BorderThickness="0" Background="Transparent"
                         Padding="0" Margin="0"
                         FontFamily="{StaticResource UiFont}"
                         FontSize="12" Foreground="{StaticResource TextBrush}"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Hidden"
                         IsTabStop="False" AcceptsReturn="False" AcceptsTab="False" />
        </Border>

        <!-- 2) 联系条：作者 + 邮箱胶囊（唯一复制入口）+ 反馈位（平时为空） -->
        <Border Grid.Row="1" Background="{StaticResource SoftGrayBrush}" CornerRadius="8"
                Padding="14,9" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="作者" FontSize="12" Foreground="{StaticResource SubBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{x:Static local:Brand.Author}" FontSize="12"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                           Margin="6,0,0,0" />

                <Border x:Name="MailPill" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="9,4" Margin="12,0,0,0"
                        Cursor="Hand" MouseLeftButtonUp="OnCopyEmail"
                        ToolTip="点击复制邮箱">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconView Icon="mail" IconSize="13" IconBrush="{StaticResource SubBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="MailText" Text="{x:Static local:Brand.Email}" FontSize="11.5"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 平时为空；点击复制后在这里显示「已复制到剪贴板」，1.6 秒后自动消失 -->
                <TextBlock x:Name="CopyHint" Text="" FontSize="11.5"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 3) 按钮栏：只有一个关闭（复制已由邮箱胶囊承担） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Width="96"
                    IsDefault="True" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</ui:DialogWindow>
