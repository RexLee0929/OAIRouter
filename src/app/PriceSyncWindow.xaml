<Window x:Class="OAIRouter.PriceSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OAIRouter.Ui"
        Title="从上游同步价格"
        Width="820" Height="620" MinWidth="620" MinHeight="460"
        Background="#F2F6FB" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 来源 / 地址 / 鉴权 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="来源" Style="{StaticResource Sub}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="SourceBox" Style="{StaticResource CellCombo}" Width="200"
                              SelectionChanged="OnSourceChanged" />
                    <TextBlock Grid.Column="2" x:Name="HintText" Style="{StaticResource Hint}" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="地址" Style="{StaticResource Sub}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="UpstreamBox" Style="{StaticResource CellCombo}" Width="200"
                              Margin="0,0,8,0" Visibility="Collapsed"
                              SelectionChanged="OnUpstreamChanged"
                              ToolTip="已配置的上游，选中会自动填地址；也可以直接在右边输入任意站点" />
                    <TextBox Grid.Column="2" x:Name="UrlBox" Style="{StaticResource Input}" MinWidth="160"
                             ToolTip="可直接输入任意站点地址，例如 https://example.com/api/pricing" />
                    <Button Grid.Column="3" Content="获取" Style="{StaticResource PrimaryButton}" Padding="16,6"
                            Margin="8,0,0,0" Click="OnFetch" />
                </Grid>

                <Grid x:Name="AuthPanel" Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="令牌" Style="{StaticResource Sub}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="TokenBox" Style="{StaticResource Input}" MinWidth="140"
                             ToolTip="站点设为「登录可见」时必填；与你在该站创建的令牌相同" />
                    <TextBlock Grid.Column="2" Text="用户 ID" Style="{StaticResource Sub}" Margin="12,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" x:Name="UserBox" Style="{StaticResource Input}"
                             ToolTip="new-api 需要 New-Api-User 头，填数字用户 ID；不确定可留空先试" />
                </Grid>
            </Grid>
        </Border>

        <!-- 结果 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="30" Margin="4,4,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectAll" Grid.Column="0" Click="OnSelectAll"
                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="模型 · 挡位" Style="{StaticResource Hint}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="输入 $/1M" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="输出 $/1M" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="缓存读" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="缓存写" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ResultItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5FA" BorderThickness="0,0,0,1">
                                    <Grid Height="28" Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CellText}" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding InputText}" Style="{StaticResource CellText}" />
                                        <TextBlock Grid.Column="3" Text="{Binding OutputText}" Style="{StaticResource CellText}" />
                                        <TextBlock Grid.Column="4" Text="{Binding CacheReadText}" Style="{StaticResource CellText}" />
                                        <TextBlock Grid.Column="5" Text="{Binding CacheWriteText}" Style="{StaticResource CellText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="84" Click="OnCancel" />
                <Button Content="添加选中" Style="{StaticResource PrimaryButton}" Width="104" Margin="8,0,0,0"
                        Click="OnConfirm" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
