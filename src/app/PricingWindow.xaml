<Window x:Class="OAIRouter.PricingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OAIRouter.Ui"
        Title="价格设置"
        Width="1240" Height="640" MinWidth="1140" MinHeight="500"
        Background="#F2F6FB" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="添加一行" Style="{StaticResource GhostButton}" Padding="12,5" Click="OnAdd" />
                    <Button x:Name="SortBtn" Content="名称 ↑" Style="{StaticResource GhostButton}" Padding="12,5"
                            Margin="6,0,0,0" Click="OnSortByName"
                            ToolTip="按模型名排序，同名按路由和挡位起点；再次点击切换升降序" />
                    <Button Content="从上游同步" Style="{StaticResource PrimaryButton}" Padding="14,6"
                            Margin="8,0,0,0" Click="OnOpenSync" />
                    <Border Width="1" Height="16" Background="{StaticResource LineBrush}" Margin="14,0" />
                    <TextBlock Text="单价：美元 / 百万 token" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 表头（两层：分组 + 字段） -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" Margin="0,12,0,0" Padding="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="模型" Style="{StaticResource Hint}"
                               Margin="14,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="挡位（输入 token）" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Grid.ColumnSpan="4" Text="价格（美元 / 百万 token）" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="8" Grid.ColumnSpan="2" Text="生效时段（每天）" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="10" Text="有效期" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="路由" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="模型" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="起" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="止" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="留空表示无上限" />
                    <TextBlock Grid.Column="4" Text="输入" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="输出" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="缓存读" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="缓存写" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="8" Text="起" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="留空表示全天" />
                    <TextBlock Grid.Column="9" Text="止" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="可跨零点" />
                    <TextBlock Grid.Column="10" Text="至" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="yyyy-MM-dd，留空=长期" />
                </Grid>
            </Grid>
        </Border>

        <!-- 规则行 -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" Margin="0,6,0,0" Padding="0,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PriceItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F1F5FA" BorderThickness="0,0,0,1">
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" Style="{StaticResource CellCombo}" Margin="8,0,4,0"
                                              IsEditable="True"
                                              ItemsSource="{Binding DataContext.RouteOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding Route, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="选已添加的路由；* 表示全部" />

                                    <ComboBox Grid.Column="1" Style="{StaticResource CellCombo}" Margin="4,0,4,0"
                                              IsEditable="True"
                                              ItemsSource="{Binding DataContext.ModelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="从模型库选择或直接输入；* 表示全部" />

                                    <TextBox Grid.Column="2" Style="{StaticResource CellInput}"
                                             Text="{Binding TierFrom, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalContentAlignment="Center" />
                                    <TextBox Grid.Column="3" Style="{StaticResource CellInput}"
                                             Text="{Binding TierTo, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalContentAlignment="Center" />

                                    <TextBox Grid.Column="4" Style="{StaticResource CellInput}"
                                             Text="{Binding InputPerM, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.####}}"
                                             HorizontalContentAlignment="Center" />
                                    <TextBox Grid.Column="5" Style="{StaticResource CellInput}"
                                             Text="{Binding OutputPerM, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.####}}"
                                             HorizontalContentAlignment="Center" />
                                    <TextBox Grid.Column="6" Style="{StaticResource CellInput}"
                                             Text="{Binding CacheReadPerM, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.####}}"
                                             HorizontalContentAlignment="Center" />
                                    <TextBox Grid.Column="7" Style="{StaticResource CellInput}"
                                             Text="{Binding CacheWritePerM, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.####}}"
                                             HorizontalContentAlignment="Center" />

                                    <ComboBox Grid.Column="8" Style="{StaticResource CellCombo}" Margin="4,0,2,0"
                                              IsEditable="True"
                                              ItemsSource="{Binding DataContext.TimeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding TimeFrom, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="9" Style="{StaticResource CellCombo}" Margin="2,0,4,0"
                                              IsEditable="True"
                                              ItemsSource="{Binding DataContext.TimeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding TimeTo, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBox Grid.Column="10" Style="{StaticResource CellInput}"
                                             Text="{Binding ValidTo, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalContentAlignment="Center" />

                                    <Button Grid.Column="11" Style="{StaticResource RowDelete}" Click="OnRemove"
                                            HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Text="匹配优先级：路由精确 &gt; 模型精确 &gt; 限定时段 &gt; 挡位窄；都匹配不上则不计价。" />
            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Width="96"
                    HorizontalAlignment="Right" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
