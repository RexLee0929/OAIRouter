<Window x:Class="OAIRouter.Toast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OAIRouter"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <Border Margin="16" Background="White" CornerRadius="10"
            BorderBrush="#DEE6F0" BorderThickness="1" Padding="14,11"
            MinWidth="230" MaxWidth="370">
        <StackPanel Orientation="Horizontal">
            <Path x:Name="Glyph" Width="16" Height="16" Stretch="Uniform"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" Margin="0,1,9,0" />
            <TextBlock x:Name="Message" FontFamily="Microsoft YaHei UI" FontSize="12"
                       Foreground="#1B1B1B" TextWrapping="Wrap" MaxWidth="320" LineHeight="18" />
        </StackPanel>
    </Border>
</Window>
